{
  "manifest_version": 3,
  "name": "NowPlaying for YouTube",
  "version": "0.1.0",
  "description": "Sends what is playing on YouTube and YouTube Music to the NowPlaying app on this PC. Nothing else.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "NowPlaying for YouTube", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["reader.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
